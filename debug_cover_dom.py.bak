"""探测封面区域DOM结构"""
import json
import time
from DrissionPage import ChromiumPage, ChromiumOptions

COOKIE_FILE = "toutiao_cookies.json"
PUBLISH_URL = "https://mp.toutiao.com/profile_v4/graphic/publish"

with open(COOKIE_FILE, "r", encoding="utf-8") as f:
    cookies = json.load(f)

co = ChromiumOptions()
co.headless(True)
co.set_argument("--no-sandbox")
co.set_argument("--disable-gpu")

page = ChromiumPage(co)
page.get("https://mp.toutiao.com")
time.sleep(2)

for name, value in cookies.items():
    try:
        page.set.cookies({"name": name, "value": value, "domain": ".toutiao.com", "path": "/"})
    except Exception:
        pass

page.get("https://mp.toutiao.com")
time.sleep(3)
print(f"登录状态: {page.url}")

# 访问发布页
page.get(PUBLISH_URL)
time.sleep(4)

# 先填标题和内容触发封面区域渲染
title_el = page.ele('tag:textarea', timeout=10)
if title_el:
    title_el.input("测试标题")
    print("标题已填")

# 填内容
result = page.run_js(
    "var editor = document.querySelector('.ProseMirror');\n"
    "if (editor) { editor.innerHTML = '<p>测试段落1</p><p>测试段落2</p>';"
    " editor.dispatchEvent(new Event('input', {bubbles: true})); return 'ok'; }\n"
    "return 'no';"
)
print(f"内容填充: {result}")
time.sleep(2)

# 选择三图模式
three_radio = page.ele('tag:input@type=radio@value=3', timeout=3)
if three_radio:
    three_radio.click()
    print("三图模式已选 (radio)")
else:
    result = page.run_js(
        "var labels = document.querySelectorAll('label');\n"
        "for (var i = 0; i < labels.length; i++) {\n"
        "  if (labels[i].textContent.indexOf('三图') !== -1) {\n"
        "    labels[i].click(); return 'clicked';\n"
        "  }\n"
        "}\n"
        "return 'no';"
    )
    print(f"三图模式: {result}")

time.sleep(2)

# 探测封面区域DOM
dom_info = page.run_js("""
var result = [];
// 查找包含"封面"文字的元素
var all = document.querySelectorAll('*');
for (var i = 0; i < all.length; i++) {
    var el = all[i];
    var text = (el.textContent || '').trim();
    if (text.indexOf('封面') !== -1 && text.length < 50) {
        result.push({
            tag: el.tagName,
            class: el.className,
            text: text.substring(0, 30),
            rect: el.getBoundingClientRect()
        });
    }
}
// 查找所有file input
var fileInputs = document.querySelectorAll('input[type="file"]');
for (var j = 0; j < fileInputs.length; j++) {
    var fi = fileInputs[j];
    result.push({
        tag: 'INPUT[file]',
        class: fi.className,
        accept: fi.accept,
        visible: fi.getBoundingClientRect().width > 0
    });
}
// 查找可能的上传按钮
var btnCandidates = document.querySelectorAll(
    '[class*="add"], [class*="upload"], [class*="cover"], [class*="btn"]'
);
for (var k = 0; k < btnCandidates.length; k++) {
    var bc = btnCandidates[k];
    var rect = bc.getBoundingClientRect();
    if (rect.width > 0 && rect.height > 0 && rect.top > 200) {
        result.push({
            tag: bc.tagName,
            class: bc.className,
            text: (bc.textContent || '').trim().substring(0, 20),
            rect: {top: rect.top, left: rect.left, w: rect.width, h: rect.height}
        });
    }
}
return JSON.stringify(result);
""")

print("\n=== 封面区域DOM探测 ===")
print(dom_info[:3000])

page.quit()